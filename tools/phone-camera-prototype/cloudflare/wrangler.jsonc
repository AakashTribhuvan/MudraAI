{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mudra-camera-gateway",
  "main": "worker.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "TUNNEL_STATE",
        "class_name": "TunnelState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TunnelState"]
    }
  ]
}
