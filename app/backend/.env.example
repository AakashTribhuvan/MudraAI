# SignLine Emergency settings (copy to your environment; never commit real secrets)
# Google Sign-In (copy the OAuth Web client ID/secret from Google Cloud Console).
# Register BOTH this stable callback and http://localhost:3000/auth/google/callback for local preview.
# For judges, callback is the permanent Worker URL + /auth/google/callback (never the Quick Tunnel URL).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mudra-camera-gateway.aakashtribhuvan2006.workers.dev/auth/google/callback
# Optional: email addresses allowed into the admin workspace; everyone else is a learner.
SIGNLINE_ADMIN_EMAILS=
# If unset, cookies use a process-only random key; set a random persistent value to keep sessions through restarts.
SIGNLINE_AUTH_SECRET=
SIGNLINE_AUTH_COOKIE_SECURE=true

# Database (default: SQLite in app/backend/var/, git-ignored)
# SIGNLINE_EM_DATABASE_URL=sqlite:///C:/path/to/signline_emergency.db
# Signs responder login tokens. Unset = random per server start (logins end on restart)
SIGNLINE_EM_SECRET_KEY=
SIGNLINE_EM_TOKEN_TTL_S=28800
# Demo mode: mock recognition / location / dispatch, clearly labelled. Reports reach only the in-app demo responder desk.
SIGNLINE_EM_DEMO_MODE=true
# mock | real (real = the SignLine /stream model through the adapter; see signline_emergency README section)
SIGNLINE_EM_RECOGNITION_PROVIDER=mock
SIGNLINE_EM_DISPATCH_PROVIDER=mock
SIGNLINE_EM_DISPATCH_DESTINATION=signline-demo-responder-desk
# Demo responder password. Unset = generated once into app/backend/var/demo_responder_credentials.txt
SIGNLINE_EM_DEMO_RESPONDER_PASSWORD=
SIGNLINE_EM_RETENTION_DAYS=30
SIGNLINE_EM_RATE_LIMIT_PER_MIN=30
SIGNLINE_EM_RUN_MIGRATIONS=true
# Gesture demonstration videos (consented, per device); default app/backend/var/emergency_media
# SIGNLINE_EM_MEDIA_DIR=
# AES-256-GCM key for them (base64, 32 bytes); unset = generated once into app/backend/var/emergency_media.key
# SIGNLINE_EM_MEDIA_KEY=
# Gesture videos are deleted this many days after recording (0 = keep); retention runs every N hours (0 = off)
SIGNLINE_EM_GESTURE_VIDEO_RETENTION_DAYS=365
SIGNLINE_EM_RETENTION_INTERVAL_H=24

# Meeting speech (docs/MEETING_INTEGRATION.md): streaming ASR model folder (sherpa-onnx, not in git)
# MUDRA_ASR_MODEL_DIR=app/backend/var/asr_models/sherpa-onnx-streaming-zipformer-en-2023-06-26
# Origins of hosted meeting surfaces (Meet add-on / Zoom App), comma separated
# MUDRA_CORS_ORIGINS=https://your-host.example
