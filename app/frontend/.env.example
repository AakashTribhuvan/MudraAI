# Copy to .env.local to override (Vite reads env files from this folder)
VITE_API_URL=http://localhost:8000
# auto = use the trained model when the backend is reachable; off = rule-based fallback only
VITE_SIGN_MODEL=auto
# Meeting surfaces (docs/MEETING_INTEGRATION.md): Google Cloud project number of the registered Meet add-on
# VITE_MEET_CLOUD_PROJECT_NUMBER=
